# アプリ
API_PORT=5000
WEB_PORT=3000

# =============================================================================
# Firebase — 開発（Emulator・docker compose 向け）
# =============================================================================
REACT_APP_USE_FIREBASE_EMULATOR=true
FIREBASE_PROJECT_ID=demo-hakkason
REACT_APP_FIREBASE_PROJECT_ID=demo-hakkason
REACT_APP_FIREBASE_API_KEY=demo-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=demo-hakkason.firebaseapp.com
REACT_APP_FIREBASE_STORAGE_BUCKET=demo-hakkason.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=000000000000
REACT_APP_FIREBASE_APP_ID=1:000000000000:web:demo
REACT_APP_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
REACT_APP_FIRESTORE_EMULATOR_HOST=localhost:8080

# =============================================================================
# Firebase — 本番（クラウド Firestore）に接続するとき
# Firebase Console → プロジェクトの設定 → マイアプリ → 構成 をコピー
# =============================================================================
# REACT_APP_USE_FIREBASE_EMULATOR=false
# FIREBASE_PROJECT_ID=your-project-id
# REACT_APP_FIREBASE_PROJECT_ID=your-project-id
# REACT_APP_FIREBASE_API_KEY=AIza...
# REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789
# REACT_APP_FIREBASE_APP_ID=1:123456789:web:abcdef
# 本番時は Emulator 用ホストを設定しない（行ごと削除 or 空にしない）
